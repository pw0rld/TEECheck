{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://teecheck.dev/schemas/findings.v2.json",
  "title": "TEECheck Findings v2",
  "type": "object",
  "required": ["schema_version", "run_id", "findings"],
  "properties": {
    "schema_version": {"const": "teecheck.findings.v2"},
    "run_id": {"type": "string", "minLength": 1},
    "findings": {
      "type": "array",
      "items": {"$ref": "#/$defs/finding"}
    }
  },
  "additionalProperties": false,
  "$defs": {
    "strings": {
      "type": "array",
      "items": {"type": "string"}
    },
    "location": {
      "type": "object",
      "required": ["path", "start_line"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "start_line": {"type": "integer", "minimum": 1},
        "symbol": {"type": "string"}
      },
      "additionalProperties": false
    },
    "sections": {
      "type": "object",
      "properties": {
        "anchored_tool_facts": {"$ref": "#/$defs/strings"},
        "architecture_evidence_status": {"$ref": "#/$defs/strings"},
        "invariant_verification_status": {"$ref": "#/$defs/strings"},
        "expert_hypothesis": {"type": "string"},
        "independent_challenger_result": {"type": "string"},
        "verifier_resolution": {"type": "string"},
        "remaining_coverage_gaps": {"$ref": "#/$defs/strings"},
        "human_review_questions": {"$ref": "#/$defs/strings"}
      },
      "additionalProperties": false
    },
    "finding": {
      "type": "object",
      "required": [
        "finding_id",
        "slice_id",
        "status",
        "severity",
        "confidence",
        "summary"
      ],
      "properties": {
        "finding_id": {"type": "string", "minLength": 1},
        "slice_id": {"type": "string", "minLength": 1},
        "status": {
          "enum": [
            "no_issue_observed",
            "needs_review",
            "likely_issue",
            "confirmed_candidate"
          ]
        },
        "severity": {"enum": ["high", "medium", "low"]},
        "confidence": {"enum": ["high", "medium", "low"]},
        "files": {"$ref": "#/$defs/strings"},
        "related_twes": {"$ref": "#/$defs/strings"},
        "locations": {
          "type": "array",
          "items": {"$ref": "#/$defs/location"}
        },
        "summary": {"type": "string", "minLength": 1},
        "evidence": {"$ref": "#/$defs/strings"},
        "sections": {"$ref": "#/$defs/sections"}
      },
      "additionalProperties": false
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://teecheck.dev/schemas/architecture.v1.json",
  "title": "TEECheck ArchitectureModel v1",
  "type": "object",
  "required": ["schema_version", "run_id", "repo"],
  "properties": {
    "schema_version": {"const": "teecheck.architecture.v1"},
    "run_id": {"type": "string", "minLength": 1},
    "repo": {"type": "object"},
    "parties": {"$ref": "#/$defs/elements"},
    "components": {"$ref": "#/$defs/elements"},
    "roles": {"$ref": "#/$defs/elements"},
    "assets": {"$ref": "#/$defs/elements"},
    "trust_zones": {"$ref": "#/$defs/elements"},
    "entrypoints": {"$ref": "#/$defs/elements"},
    "boundaries": {"$ref": "#/$defs/relations"},
    "data_flows": {"$ref": "#/$defs/relations"},
    "state_lifecycles": {"$ref": "#/$defs/relations"},
    "trust_assumptions": {"$ref": "#/$defs/elements"},
    "deployment_assumptions": {"$ref": "#/$defs/elements"},
    "unknowns": {"$ref": "#/$defs/elements"}
  },
  "additionalProperties": false,
  "$defs": {
    "state": {"enum": ["observed", "inferred", "documented", "unknown"]},
    "evidence": {
      "type": "object",
      "required": ["kind"],
      "properties": {
        "kind": {"type": "string"}, "file": {"type": "string"},
        "start_line": {"type": "integer", "minimum": 1},
        "end_line": {"type": "integer", "minimum": 1},
        "artifact_ref": {"type": "string"}, "tool": {"type": "string"},
        "note": {"type": "string"}
      },
      "additionalProperties": false
    },
    "element": {
      "type": "object",
      "required": ["id", "kind", "name", "state"],
      "properties": {
        "id": {"type": "string"}, "kind": {"type": "string"},
        "name": {"type": "string"}, "description": {"type": "string"},
        "role": {"type": "string"}, "zone": {"type": "string"},
        "state": {"$ref": "#/$defs/state"}, "confidence": {"type": "string"},
        "evidence": {"type": "array", "items": {"$ref": "#/$defs/evidence"}},
        "dependencies": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": false
    },
    "relation": {
      "type": "object",
      "required": ["id", "kind", "from", "to", "state"],
      "properties": {
        "id": {"type": "string"}, "kind": {"type": "string"},
        "from": {"type": "string"}, "to": {"type": "string"},
        "description": {"type": "string"}, "state": {"$ref": "#/$defs/state"},
        "confidence": {"type": "string"},
        "evidence": {"type": "array", "items": {"$ref": "#/$defs/evidence"}},
        "dependencies": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": false
    },
    "elements": {"type": "array", "items": {"$ref": "#/$defs/element"}},
    "relations": {"type": "array", "items": {"$ref": "#/$defs/relation"}}
  }
}

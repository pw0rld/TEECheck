{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://teecheck.dev/schemas/project-profile.v2.json",
  "title": "TEECheck ProjectProfile v2",
  "type": "object",
  "required": ["schema_version", "run_id", "repo"],
  "properties": {
    "schema_version": {"const": "teecheck.project_profile.v2"},
    "run_id": {"type": "string", "minLength": 1},
    "repo": {"$ref": "#/$defs/repo"},
    "languages": {"type": "array", "items": {"type": "string"}},
    "build_systems": {"type": "array", "items": {"type": "string"}},
    "tee_platforms": {"$ref": "#/$defs/signals"},
    "candidate_roles": {"$ref": "#/$defs/signals"},
    "trust_artifacts": {"$ref": "#/$defs/signals"},
    "manifests": {"$ref": "#/$defs/signals"},
    "boundary_signals": {"$ref": "#/$defs/signals"},
    "state_signals": {"$ref": "#/$defs/signals"},
    "sensitive_paths": {"type": "array", "items": {"type": "string"}},
    "top_level_dirs": {"type": "array", "items": {"type": "string"}},
    "framework_hints": {"type": "array", "items": {"type": "string"}},
    "coverage_warnings": {"type": "array", "items": {"type": "string"}}
  },
  "additionalProperties": false,
  "$defs": {
    "repo": {
      "type": "object",
      "required": ["url", "commit"],
      "properties": {
        "url": {"type": "string"},
        "commit": {"type": "string"},
        "focus": {"type": "string"}
      },
      "additionalProperties": false
    },
    "evidence": {
      "type": "object",
      "required": ["kind"],
      "properties": {
        "kind": {"type": "string"},
        "file": {"type": "string"},
        "start_line": {"type": "integer", "minimum": 1},
        "end_line": {"type": "integer", "minimum": 1},
        "artifact_ref": {"type": "string"},
        "tool": {"type": "string"},
        "note": {"type": "string"}
      },
      "additionalProperties": false
    },
    "signal": {
      "type": "object",
      "required": ["id", "kind", "name"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "kind": {"type": "string", "minLength": 1},
        "name": {"type": "string", "minLength": 1},
        "status": {"type": "string"},
        "detector": {"type": "string"},
        "scope": {"type": "string"},
        "confidence": {"type": "string"},
        "evidence": {"type": "array", "items": {"$ref": "#/$defs/evidence"}}
      },
      "additionalProperties": false
    },
    "signals": {"type": "array", "items": {"$ref": "#/$defs/signal"}}
  }
}
